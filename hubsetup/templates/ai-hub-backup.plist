<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>$user_home</string>
$hub_environment		<key>PATH</key>
		<string>$path</string>
	</dict>
	<key>Label</key>
	<string>$label_prefix.ai-hub-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>$python</string>
		<string>-m</string>
		<string>hubbackup</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>$hub_home/logs/hubbackup.log</string>
	<key>StandardOutPath</key>
	<string>$hub_home/logs/hubbackup.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>12</integer>
			<key>Minute</key>
			<integer>45</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>23</integer>
			<key>Minute</key>
			<integer>45</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>$repo</string>
</dict>
</plist>
