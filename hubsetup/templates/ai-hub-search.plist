<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>$user_home</string>
$hub_environment		<key>PATH</key>
		<string>/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>$label_prefix.ai-hub-search</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "$$(/usr/libexec/java_home -v 21)/bin/java" -Xmx512m --enable-native-access=ALL-UNNAMED -jar $search_jar serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>$hub_home/logs/search-serve.log</string>
	<key>StandardOutPath</key>
	<string>$hub_home/logs/search-serve.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>$hub_home</string>
</dict>
</plist>
