<?xml version="1.0" encoding="UTF-8"?>
<!-- 견본. 복사해 com.<사용자>.ai-hub-collector.plist 로 바꾸고 경로를 채운 뒤 launchctl bootstrap 으로 등록한다.
     등록은 수동 실행 검증 뒤 사용자 승인을 받고 한다(계획 7절). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.ai-hub-collector</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-m</string>
		<string>collector</string>
		<string>run</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/path/to/ai-hub</string>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/path/to/home/.ai-hub/logs/collector.out.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/home/.ai-hub/logs/collector.err.log</string>
</dict>
</plist>
